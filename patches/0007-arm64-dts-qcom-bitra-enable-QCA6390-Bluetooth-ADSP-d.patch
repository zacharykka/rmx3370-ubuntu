From faaa450ddd11693e147a883fd6ee71a157524701 Mon Sep 17 00:00:00 2001
From: ut-bitra <ut-bitra@localhost>
Date: Sun, 22 Nov 2026 14:08:03 +0800
Subject: [PATCH] arm64: dts: qcom: bitra: enable QCA6390 Bluetooth, ADSP, dual
 TFA9874 speakers & WCD9380 mics

- Add mainline NXP TFA9874 DSP-less TDM/I2S smart speaker amplifier codec
  driver (sound/soc/codecs/tfa9874.c) with revision-specific init,
  RMX3370 boost/PWM tuning, safe default gain, and dynamic 16/24/32-bit
  I2S configuration (TDMNBCK=0 for 32 BCLKs/frame).
- Update sound/soc/qcom/sm8250.c so TERTIARY_MI2S_RX applies DAI format
  to all attached codec DAIs (dual TFA9874 stereo pair).
- Wire QCA6390 Bluetooth on &uart6 (aliases serial1 = &uart6) sharing
  qca6390-pmu, &adsp remoteproc, dual TFA9874 amps on &i2c15 (0x34/0x35)
  over TERTIARY_MI2S_RX sd-lines=<1> (gpio137 mi2s2_data1), and WCD9380
  codec + LPASS rx/tx/va macros + SoundWire swr1/swr2 for dual analog
  microphones (AMIC1 + AMIC5).
---
 .../boot/dts/qcom/sm8250-realme-bitra.dts     | 231 ++++++++
 sound/soc/codecs/Kconfig                      |   9 +
 sound/soc/codecs/Makefile                     |   2 +
 sound/soc/codecs/tfa9874.c                    | 555 ++++++++++++++++++
 sound/soc/qcom/sm8250.c                       |   9 +-
 5 files changed, 804 insertions(+), 2 deletions(-)
 create mode 100644 sound/soc/codecs/tfa9874.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 6a60c4690..483c35aa4 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -15,6 +15,8 @@
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
 #include <dt-bindings/usb/pd.h>
 #include "sm8250.dtsi"
 #include "pm8150.dtsi"
@@ -64,6 +66,10 @@ memory {
 		reg = <0x0 0x0 0x0 0x0>;
 	};
 
+	aliases {
+		serial1 = &uart6;
+	};
+
 	chosen {
 		bootargs = "";
 	};
@@ -119,6 +125,29 @@ vph_pwr: vph-pwr-regulator {
 	};
 
 
+	wcd938x: audio-codec {
+		compatible = "qcom,wcd9380-codec";
+
+		reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
+
+		vdd-buck-supply = <&vreg_s4a_1p8>;
+		vdd-rxtx-supply = <&vreg_s4a_1p8>;
+		vdd-io-supply = <&vreg_s4a_1p8>;
+		vdd-mic-bias-supply = <&vreg_bob>;
+
+		qcom,micbias1-microvolt = <2700000>;
+		qcom,micbias2-microvolt = <2700000>;
+		qcom,micbias3-microvolt = <2700000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		#sound-dai-cells = <1>;
+	};
+
 	qca6390-pmu {
 		compatible = "qcom,qca6390-pmu";
 
@@ -869,3 +898,205 @@ ts_reset_active: ts-reset-active-state {
 		bias-pull-up;
 	};
 };
+
+/* QCA6390 Bluetooth over QUP0 UART6 (0x998000), sharing qca6390-pmu */
+&uart6 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qca6390-bt";
+
+		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
+		vddaon-supply = <&vreg_pmu_aon_0p59>;
+		vddbtcmx-supply = <&vreg_pmu_btcmx_0p85>;
+		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
+		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
+		vddrfa1p7-supply = <&vreg_pmu_rfa_1p7>;
+	};
+};
+
+/* Audio DSP (ADSP) remoteproc */
+&adsp {
+	status = "okay";
+	firmware-name = "qcom/sm8250/realme/bitra/adsp.mdt";
+};
+
+/* Dual NXP TFA9874 stereo smart speaker amplifiers on QUP2 I2C15 (0x884000) */
+&i2c15 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	tfa9874_left: speaker-amp@34 {
+		compatible = "nxp,tfa9874";
+		reg = <0x34>;
+		vdd-supply = <&vreg_s4a_1p8>;
+		nxp,tdm-slot = <0>;
+		sound-name-prefix = "SpkrLeft";
+		#sound-dai-cells = <0>;
+	};
+
+	tfa9874_right: speaker-amp@35 {
+		compatible = "nxp,tfa9874";
+		reg = <0x35>;
+		vdd-supply = <&vreg_s4a_1p8>;
+		nxp,tdm-slot = <1>;
+		sound-name-prefix = "SpkrRight";
+		#sound-dai-cells = <0>;
+	};
+};
+
+&rxmacro {
+	status = "okay";
+};
+
+&txmacro {
+	status = "okay";
+};
+
+&vamacro {
+	status = "okay";
+};
+
+&swr1 {
+	status = "okay";
+
+	wcd_rx: wcd9380-rx@0,4 {
+		compatible = "sdw20217010d00";
+		reg = <0 4>;
+		qcom,rx-port-mapping = <1 2 3 4 5>;
+	};
+};
+
+&swr2 {
+	status = "okay";
+
+	wcd_tx: wcd9380-tx@0,3 {
+		compatible = "sdw20217010d00";
+		reg = <0 3>;
+		qcom,tx-port-mapping = <2 3 4 5>;
+	};
+};
+
+&q6afedai {
+	dai@20 {
+		reg = <TERTIARY_MI2S_RX>;
+		qcom,sd-lines = <1>;
+	};
+};
+
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+
+	dai@2 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+	};
+};
+
+&tlmm {
+	tert_mi2s_data1_active: tert-mi2s-data1-active-state {
+		pins = "gpio137";
+		function = "mi2s2_data1";
+		drive-strength = <8>;
+		bias-disable;
+	};
+};
+
+&sound {
+	compatible = "qcom,sm8250-sndcard";
+	pinctrl-names = "default";
+	pinctrl-0 = <&tert_mi2s_active>, <&tert_mi2s_data1_active>;
+	model = "realme-GT-Neo2-bitra";
+	audio-routing =
+		"IN1_HPHL", "HPHL_OUT",
+		"IN2_HPHR", "HPHR_OUT",
+		"AMIC1", "MIC BIAS1",
+		"AMIC2", "MIC BIAS2",
+		"AMIC5", "MIC BIAS3",
+		"TX SWR_ADC0", "ADC1_OUTPUT",
+		"TX SWR_ADC1", "ADC2_OUTPUT",
+		"TX SWR_ADC2", "ADC3_OUTPUT",
+		"TX SWR_ADC3", "ADC4_OUTPUT",
+		"TX SWR_DMIC0", "DMIC1_OUTPUT",
+		"TX SWR_DMIC1", "DMIC2_OUTPUT",
+		"TX SWR_DMIC2", "DMIC3_OUTPUT",
+		"TX SWR_DMIC3", "DMIC4_OUTPUT";
+
+	mm1-dai-link {
+		link-name = "MultiMedia1";
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		};
+	};
+
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		};
+	};
+
+	mm3-dai-link {
+		link-name = "MultiMedia3";
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
+		};
+	};
+
+	tertiary-mi2s-dai-link {
+		link-name = "Tertiary MI2S Playback";
+		cpu {
+			sound-dai = <&q6afedai TERTIARY_MI2S_RX>;
+		};
+		codec {
+			sound-dai = <&tfa9874_left>, <&tfa9874_right>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	wcd-playback-dai-link {
+		link-name = "WCD Playback";
+		cpu {
+			sound-dai = <&q6afedai RX_CODEC_DMA_RX_0>;
+		};
+		codec {
+			sound-dai = <&wcd938x 0>, <&swr1 0>, <&rxmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	wcd-capture-dai-link {
+		link-name = "WCD Capture";
+		cpu {
+			sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
+		};
+		codec {
+			sound-dai = <&wcd938x 1>, <&swr2 0>, <&txmacro 0>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+
+	va-dai-link {
+		link-name = "VA Capture";
+		cpu {
+			sound-dai = <&q6afedai VA_CODEC_DMA_TX_0>;
+		};
+		codec {
+			sound-dai = <&vamacro 0>;
+		};
+		platform {
+			sound-dai = <&q6routing>;
+		};
+	};
+};
