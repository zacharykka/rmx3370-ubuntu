diff --git a/drivers/soc/qcom/oplus_bitra_sensor_smem.c b/drivers/soc/qcom/oplus_bitra_sensor_smem.c
new file mode 100644
index 000000000..493c694a5
--- /dev/null
+++ b/drivers/soc/qcom/oplus_bitra_sensor_smem.c
@@ -0,0 +1,226 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Populate OPLUS SMEM_SENSOR (SMEM item 130, 4768 bytes) on realme GT Neo 2
+ * (RMX3370 / bitra) so Qualcomm SLPI firmware probes all onboard SSC sensors
+ * (accelerometer, gyroscope, magnetometer, ambient light, proximity) with
+ * correct orientation matrices and calibration parameters.
+ */
+
+#include <linux/build_bug.h>
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/soc/qcom/smem.h>
+#include <linux/string.h>
+
+#define SMEM_SENSOR		130
+#define REG_NUM			10
+#define PARAMETER_NUM		25
+#define FEATURE_NUM		10
+#define SOURCE_NUM		2
+#define ALGO_PARAMETER_NUM	15
+#define ALGO_FEATURE_NUM	5
+#define SENSORS_NUM		11
+#define SENSOR_ALGO_NUM		8
+#define DEFAULT_CONFIG		0xff
+
+enum {
+	OPLUS_ACCEL	= 0,
+	OPLUS_GYRO	= 1,
+	OPLUS_MAG	= 2,
+	OPLUS_LIGHT	= 3,
+	OPLUS_PROXIMITY	= 4,
+	OPLUS_CCT_REAR	= 7,
+};
+
+struct oplus_sensor_feature {
+	int reg[REG_NUM];
+	int parameter[PARAMETER_NUM];
+	int feature[FEATURE_NUM];
+};
+
+struct oplus_sensor_hw {
+	u8 sensor_name;
+	u8 bus_number;
+	u8 direction;
+	u8 irq_number;
+	struct oplus_sensor_feature feature;
+};
+
+struct oplus_sensor_vector {
+	int sensor_id;
+	struct oplus_sensor_hw hw[SOURCE_NUM];
+};
+
+struct oplus_sensor_algorithm {
+	int sensor_id;
+	int parameter[ALGO_PARAMETER_NUM];
+	int feature[ALGO_FEATURE_NUM];
+};
+
+struct oplus_sensor_info {
+	int magic_num;
+	struct oplus_sensor_vector s_vector[SENSORS_NUM];
+	struct oplus_sensor_algorithm a_vector[SENSOR_ALGO_NUM];
+};
+
+static int oplus_bitra_sensor_smem_probe(struct platform_device *pdev)
+{
+	static const int mag0_para[18] = {
+		0x29a0, 0x00, 0x00d1, 0x00, 0x00b6, 0x01,
+		0x011e, 0x00, 0x24ae, 0x00, 0x0137, 0x01,
+		0x0161, 0x00, 0x0055, 0x00, 0x28e4, 0x00
+	};
+	static const int mag1_para[18] = {
+		0x270e, 0x00, 0x0002, 0x00, 0x0068, 0x01,
+		0x007a, 0x00, 0x23b9, 0x00, 0x010d, 0x01,
+		0x0028, 0x00, 0x00c3, 0x00, 0x26eb, 0x00
+	};
+	static const int ps_para[23] = {
+		0x12c, 0x190, 0x2bc, 0x384, 0x1f4, 0x2bc, 0x708, 0x7d0,
+		0x000, 0x73a, 0x005, 0x190, 0x064, 0x7d0, 0x046, 0x1194,
+		0x3e8, 0xea60, 0x000, 0xfffe, 0x7d0, 0x01e, 0xbb8
+	};
+	struct oplus_sensor_info *chip;
+	struct oplus_sensor_hw *hw;
+	size_t smem_size = 0;
+	void *smem_addr;
+	int ret;
+
+	BUILD_BUG_ON(sizeof(struct oplus_sensor_info) != 4768);
+
+	{
+		u32 dtsi_no = 0;
+		if (!of_machine_is_compatible("realme,bitra") &&
+		    (of_property_read_u32(of_root, "oplus,dtsi_no", &dtsi_no) || dtsi_no != 0x5473))
+			return 0;
+	}
+
+	ret = qcom_smem_alloc(QCOM_SMEM_HOST_ANY, SMEM_SENSOR,
+			      sizeof(struct oplus_sensor_info));
+	if (ret == -EPROBE_DEFER)
+		return -EPROBE_DEFER;
+	if (ret < 0 && ret != -EEXIST) {
+		dev_warn(&pdev->dev, "qcom_smem_alloc(%d) failed: %d\n",
+			 SMEM_SENSOR, ret);
+		return 0;
+	}
+
+	smem_addr = qcom_smem_get(QCOM_SMEM_HOST_ANY, SMEM_SENSOR, &smem_size);
+	if (IS_ERR(smem_addr)) {
+		if (PTR_ERR(smem_addr) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		dev_warn(&pdev->dev, "qcom_smem_get(%d) failed: %ld\n",
+			 SMEM_SENSOR, PTR_ERR(smem_addr));
+		return 0;
+	}
+	if (smem_size < sizeof(struct oplus_sensor_info)) {
+		pr_err("oplus-sensor-smem: item %d size %zu < %zu\n",
+		       SMEM_SENSOR, smem_size, sizeof(struct oplus_sensor_info));
+		return 0;
+	}
+
+	chip = smem_addr;
+	memset(chip, 0, sizeof(*chip));
+
+	/* Accelerometer / Gyroscope (ICM4X607 / LSM6DS3_C, direction=3) */
+	chip->s_vector[OPLUS_ACCEL].sensor_id = OPLUS_ACCEL;
+	hw = &chip->s_vector[OPLUS_ACCEL].hw[0];
+	hw->sensor_name = 0x40;
+	hw->bus_number = DEFAULT_CONFIG;
+	hw->direction = 3;
+	hw->irq_number = DEFAULT_CONFIG;
+
+	hw = &chip->s_vector[OPLUS_ACCEL].hw[1];
+	hw->sensor_name = 0x04;
+	hw->bus_number = DEFAULT_CONFIG;
+	hw->direction = 3;
+	hw->irq_number = DEFAULT_CONFIG;
+
+	/* Magnetometer (AKM09918 / MMC5603, direction=5 + soft-iron matrix) */
+	chip->s_vector[OPLUS_MAG].sensor_id = OPLUS_MAG;
+	hw = &chip->s_vector[OPLUS_MAG].hw[0];
+	hw->sensor_name = 0x01;
+	hw->bus_number = DEFAULT_CONFIG;
+	hw->direction = 5;
+	hw->irq_number = DEFAULT_CONFIG;
+	memcpy(hw->feature.parameter, mag0_para, sizeof(mag0_para));
+
+	hw = &chip->s_vector[OPLUS_MAG].hw[1];
+	hw->sensor_name = 0x02;
+	hw->bus_number = DEFAULT_CONFIG;
+	hw->direction = 5;
+	hw->irq_number = DEFAULT_CONFIG;
+	memcpy(hw->feature.parameter, mag1_para, sizeof(mag1_para));
+
+	/* Ambient Light Sensor (STK3329 on SSC I2C5, irq 0x81) */
+	chip->s_vector[OPLUS_LIGHT].sensor_id = OPLUS_LIGHT;
+	hw = &chip->s_vector[OPLUS_LIGHT].hw[0];
+	hw->sensor_name = 0x10;
+	hw->bus_number = 5;
+	hw->direction = DEFAULT_CONFIG;
+	hw->irq_number = 0x81;
+	hw->feature.feature[0] = 1;    /* als-type */
+	hw->feature.feature[1] = 1;    /* is-unit-device */
+	hw->feature.feature[2] = 0;    /* is-als-dri */
+	hw->feature.feature[3] = 0x6e; /* als-factor */
+	hw->feature.feature[4] = 0;    /* is_als_initialed */
+	hw->feature.feature[5] = 0x0a; /* als_buffer_length */
+	hw->feature.feature[6] = 1057; /* normalization_value */
+	hw->feature.parameter[6] = 1001; /* gold-reset-scale */
+
+	/* Proximity Sensor (STK3329 on SSC I2C5, irq 0x81) */
+	chip->s_vector[OPLUS_PROXIMITY].sensor_id = OPLUS_PROXIMITY;
+	hw = &chip->s_vector[OPLUS_PROXIMITY].hw[0];
+	hw->sensor_name = 0x10;
+	hw->bus_number = 5;
+	hw->direction = DEFAULT_CONFIG;
+	hw->irq_number = 0x81;
+	hw->feature.feature[0] = 1; /* ps-type */
+	memcpy(hw->feature.parameter, ps_para, sizeof(ps_para));
+
+	/* Rear CCT sensor (TCS3408 on SSC I2C4) */
+	chip->s_vector[OPLUS_CCT_REAR].sensor_id = OPLUS_CCT_REAR;
+	hw = &chip->s_vector[OPLUS_CCT_REAR].hw[0];
+	hw->sensor_name = 0x01;
+	hw->bus_number = 4;
+	hw->direction = DEFAULT_CONFIG;
+	hw->irq_number = DEFAULT_CONFIG;
+
+	pr_info("oplus-sensor-smem: populated SMEM_SENSOR (%zu bytes) for realme,bitra\n",
+		sizeof(*chip));
+	return 0;
+}
+static struct platform_driver oplus_bitra_sensor_smem_driver = {
+	.probe = oplus_bitra_sensor_smem_probe,
+	.driver = {
+		.name = "oplus-bitra-sensor-smem",
+	},
+};
+
+static int __init oplus_bitra_sensor_smem_init(void)
+{
+	u32 dtsi_no = 0;
+	struct platform_device *pdev;
+	int ret;
+
+	if (!of_machine_is_compatible("realme,bitra") &&
+	    (of_property_read_u32(of_root, "oplus,dtsi_no", &dtsi_no) || dtsi_no != 0x5473))
+		return 0;
+
+	ret = platform_driver_register(&oplus_bitra_sensor_smem_driver);
+	if (ret)
+		return ret;
+
+	pdev = platform_device_register_simple("oplus-bitra-sensor-smem", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&oplus_bitra_sensor_smem_driver);
+		return PTR_ERR(pdev);
+	}
+	return 0;
+}
+device_initcall(oplus_bitra_sensor_smem_init);
+
+MODULE_DESCRIPTION("OPLUS SMEM_SENSOR initializer for realme GT Neo 2 (bitra)");
+MODULE_LICENSE("GPL");
