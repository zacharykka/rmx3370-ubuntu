From 907c508e52d83e584d9c9c35450768b01c252fc1 Mon Sep 17 00:00:00 2001
From: ut-bitra <ut-bitra@localhost>
Date: Sun, 22 Nov 2026 22:26:07 +0800
Subject: [PATCH] arm64: dts: qcom: bitra: enable AW8697 haptics, SLPI sensors,
 USB ECM fix & OLED power-off

Enable Awinic AW8697 X-axis LRA linear haptics (i2c11@0x5a, 170 Hz, EV_FF),
Qualcomm SLPI sensor hub with OPLUS SMEM_SENSOR (item 130, 4768 bytes)
initializer for all 6 onboard SSC sensors (accel, gyro, mag, compass,
light, proximity), fix USB CDC-ECM TX deadlock on suspend/reconnect in
u_ether.c + DWC3 USB2 LPM disable quirks, and model panel vout GPIO 125
as vreg_panel_vout with OPLUS POST_ON_BACKLIGHT delayed DISPON.
---
 .../boot/dts/qcom/sm8250-realme-bitra.dts     |  56 ++-
 .../gpu/drm/panel/panel-samsung-ams662zs01.c  |  64 ++-
 drivers/input/misc/Kconfig                    |  12 +
 drivers/input/misc/Makefile                   |   1 +
 drivers/input/misc/aw8697.c                   | 399 ++++++++++++++++++
 drivers/soc/qcom/Kconfig                      |   7 +
 drivers/soc/qcom/Makefile                     |   1 +
 drivers/soc/qcom/oplus_bitra_sensor_smem.c    | 226 ++++++++++
 drivers/usb/gadget/function/u_ether.c         |   9 +-
 9 files changed, 753 insertions(+), 22 deletions(-)
 create mode 100644 drivers/input/misc/aw8697.c
 create mode 100644 drivers/soc/qcom/oplus_bitra_sensor_smem.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 483c35aa4..3b768c433 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -74,6 +74,13 @@ chosen {
 		bootargs = "";
 	};
 
+	vreg_panel_vout: regulator-panel-vout {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_panel_vout";
+		gpio = <&tlmm 125 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
 	/*
 	 * Disable PSCI deep-sleep CPU/cluster idle states for now (stock bootargs
 	 * also sets lpm_levels.sleep_disabled=1; tracked in docs/tech-debt.md).
@@ -519,6 +526,31 @@ vreg_l2c_1p15: ldo2 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		/* SLPI / SSC sensor power rails (vdd2=l4c, vddio=l8c, vdd=l10c) */
+		vreg_l4c_1p8: ldo4 {
+			regulator-name = "vreg_l4c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
+		vreg_l8c_1p8: ldo8 {
+			regulator-name = "vreg_l8c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
+		vreg_l10c_3p0: ldo10 {
+			regulator-name = "vreg_l10c_3p0";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3312000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
 		vreg_l11c_3p0: ldo11 {
 			regulator-name = "vreg_l11c_3p0";
 			regulator-min-microvolt = <2832000>;
@@ -572,6 +604,9 @@ &usb_1_dwc3 {
 	maximum-speed = "high-speed";
 	phys = <&usb_1_hsphy>;
 	phy-names = "usb2-phy";
+	snps,dis_u2_susphy_quirk;
+	snps,dis_enblslpm_quirk;
+	snps,usb2-gadget-lpm-disable;
 	usb-role-switch;
 	role-switch-default-mode = "peripheral";
 };
@@ -800,9 +835,9 @@ display_panel: panel@0 {
 		vddio-supply = <&vreg_l14a_1p8>;
 		vci-supply = <&vreg_l13a_3p0>;
 		vddr-supply = <&vreg_l2c_1p15>;
+		vout-supply = <&vreg_panel_vout>;
 
 		reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
-		vout-gpios = <&tlmm 125 GPIO_ACTIVE_HIGH>;
 
 		pinctrl-0 = <&sde_dsi_active &sde_te_active>;
 		pinctrl-names = "default";
@@ -1100,3 +1135,22 @@ platform {
 		};
 	};
 };
+
+/* Sensors Low Power Island (SLPI) remoteproc for SSC sensors */
+&slpi {
+	firmware-name = "qcom/sm8250/realme/bitra/slpi.mdt";
+	status = "okay";
+};
+
+/* Awinic AW8697 X-axis 0815 LRA haptic motor on QUP1 I2C11 (0xa8c000) */
+&i2c11 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	haptics@5a {
+		compatible = "awinic,aw8697";
+		reg = <0x5a>;
+		reset-gpios = <&tlmm 72 GPIO_ACTIVE_HIGH>;
+		awinic,f0-preset = <1700>;
+	};
+};
diff --git a/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c b/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
index 7cb2bf5e9..620f0a3cf 100644
--- a/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
+++ b/drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
@@ -25,14 +25,15 @@ struct ams662zs01 {
 	struct mipi_dsi_device *dsi;
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
-	struct gpio_desc *vout_gpio;
 	struct regulator_bulk_data *supplies;
+	bool need_disp_on;
 };
 
 static const struct regulator_bulk_data ams662zs01_supplies[] = {
 	{ .supply = "vddio" },
 	{ .supply = "vci" },
 	{ .supply = "vddr" },
+	{ .supply = "vout" },
 };
 
 static inline struct ams662zs01 *to_ams662zs01(struct drm_panel *panel)
@@ -43,7 +44,7 @@ static inline struct ams662zs01 *to_ams662zs01(struct drm_panel *panel)
 static void ams662zs01_reset(struct ams662zs01 *ctx)
 {
 	/* Stock sequence: 1 (10ms) -> 0 (10ms) -> 1 (10ms); GPIO is ACTIVE_LOW */
-	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	gpiod_direction_output(ctx->reset_gpio, 0);
 	usleep_range(10000, 11000);
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	usleep_range(10000, 11000);
@@ -98,8 +99,8 @@ static int ams662zs01_on(struct ams662zs01 *ctx)
 
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_POWER_SAVE, 0x00);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x02, 0x00);
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	/* Keep display dark until .enable() turns it on after the first frame is in GRAM */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x00, 0x00);
 
 	return dsi_ctx.accum_err;
 }
@@ -131,17 +132,12 @@ static int ams662zs01_prepare(struct drm_panel *panel)
 	if (ret < 0)
 		return ret;
 
-	if (ctx->vout_gpio)
-		gpiod_set_value_cansleep(ctx->vout_gpio, 1);
-
 	usleep_range(10000, 12000);
 	ams662zs01_reset(ctx);
 
 	ret = ams662zs01_on(ctx);
 	if (ret < 0) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-		if (ctx->vout_gpio)
-			gpiod_set_value_cansleep(ctx->vout_gpio, 0);
 		regulator_bulk_disable(ARRAY_SIZE(ams662zs01_supplies), ctx->supplies);
 		return ret;
 	}
@@ -156,8 +152,6 @@ static int ams662zs01_unprepare(struct drm_panel *panel)
 	ams662zs01_off(ctx);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-	if (ctx->vout_gpio)
-		gpiod_set_value_cansleep(ctx->vout_gpio, 0);
 
 	regulator_bulk_disable(ARRAY_SIZE(ams662zs01_supplies), ctx->supplies);
 
@@ -185,8 +179,37 @@ static int ams662zs01_get_modes(struct drm_panel *panel,
 	return drm_connector_helper_get_modes_fixed(connector, &ams662zs01_mode_60hz);
 }
 
+static int ams662zs01_enable(struct drm_panel *panel)
+{
+	struct ams662zs01 *ctx = to_ams662zs01(panel);
+
+	/*
+	 * Match stock OPLUS DSI_CMD_POST_ON_BACKLIGHT: keep DISPOFF until the
+	 * first non-zero backlight update after a real frame has been committed.
+	 */
+	ctx->need_disp_on = true;
+	return 0;
+}
+
+static int ams662zs01_disable(struct drm_panel *panel)
+{
+	struct ams662zs01 *ctx = to_ams662zs01(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->need_disp_on = true;
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, 0x00, 0x00);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 16);
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return dsi_ctx.accum_err;
+}
+
 static const struct drm_panel_funcs ams662zs01_panel_funcs = {
 	.prepare = ams662zs01_prepare,
+	.enable = ams662zs01_enable,
+	.disable = ams662zs01_disable,
 	.unprepare = ams662zs01_unprepare,
 	.get_modes = ams662zs01_get_modes,
 };
@@ -194,12 +217,22 @@ static const struct drm_panel_funcs ams662zs01_panel_funcs = {
 static int ams662zs01_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct ams662zs01 *ctx = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	u8 payload[2] = { (brightness >> 8) & 0x0f, brightness & 0xff };
 	int ret;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 	ret = mipi_dsi_dcs_write(dsi, MIPI_DCS_SET_DISPLAY_BRIGHTNESS, payload, sizeof(payload));
+	if (ret >= 0 && brightness > 0 && ctx && ctx->need_disp_on) {
+		usleep_range(20000, 22000);
+		ret = mipi_dsi_dcs_set_display_on(dsi);
+		if (ret >= 0)
+			ctx->need_disp_on = false;
+	} else if (ret >= 0 && brightness == 0 && ctx && !ctx->need_disp_on) {
+		ret = mipi_dsi_dcs_set_display_off(dsi);
+		ctx->need_disp_on = true;
+	}
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
 	return ret < 0 ? ret : 0;
@@ -213,7 +246,7 @@ static struct backlight_device *ams662zs01_create_backlight(struct mipi_dsi_devi
 {
 	const struct backlight_properties props = {
 		.type = BACKLIGHT_RAW,
-		.brightness = 512,
+		.brightness = 0,
 		.max_brightness = 2047,
 	};
 
@@ -238,16 +271,11 @@ static int ams662zs01_probe(struct mipi_dsi_device *dsi)
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "Failed to get regulators\n");
 
-	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
 	if (IS_ERR(ctx->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
 				     "Failed to get reset-gpios\n");
 
-	ctx->vout_gpio = devm_gpiod_get_optional(dev, "vout", GPIOD_OUT_HIGH);
-	if (IS_ERR(ctx->vout_gpio))
-		return dev_err_probe(dev, PTR_ERR(ctx->vout_gpio),
-				     "Failed to get vout-gpios\n");
-
 	ctx->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, ctx);
 
