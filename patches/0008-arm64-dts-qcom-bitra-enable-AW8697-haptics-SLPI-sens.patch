diff --git a/drivers/input/misc/aw8697.c b/drivers/input/misc/aw8697.c
new file mode 100644
index 000000000..d60bba271
--- /dev/null
+++ b/drivers/input/misc/aw8697.c
@@ -0,0 +1,399 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Awinic AW8697 Linear Resonant Actuator (LRA) Haptic Driver
+ *
+ * Exposes standard Linux Force-Feedback (EV_FF / FF_RUMBLE) using the chip's
+ * closed-loop continuous sine-wave LRA drive mode with auto-braking.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/workqueue.h>
+
+#define AW8697_REG_ID			0x00
+#define  AW8697_CHIP_ID			0x97
+
+#define AW8697_REG_SYSINT		0x02
+#define AW8697_REG_SYSINTM		0x03
+#define  AW8697_SYSINTM_UVLO_MASK	BIT(5)
+#define  AW8697_SYSINTM_UVLO_OFF	BIT(5)
+#define  AW8697_SYSINTM_UVLO_EN		0
+
+#define AW8697_REG_SYSCTRL		0x04
+#define  AW8697_SYSCTRL_PLAY_MODE_MASK	GENMASK(3, 2)
+#define  AW8697_SYSCTRL_PLAY_MODE_CONT	(2 << 2)
+#define  AW8697_SYSCTRL_BST_MODE_MASK	BIT(1)
+#define  AW8697_SYSCTRL_BST_BYPASS	0
+#define  AW8697_SYSCTRL_WORK_MODE_MASK	BIT(0)
+#define  AW8697_SYSCTRL_STANDBY		BIT(0)
+#define  AW8697_SYSCTRL_ACTIVE		0
+
+#define AW8697_REG_GO			0x05
+#define  AW8697_GO_ENABLE		BIT(0)
+
+#define AW8697_REG_DATCTRL		0x2b
+#define  AW8697_DATCTRL_FC_MASK		GENMASK(7, 6)
+#define  AW8697_DATCTRL_FC_1000HZ	(3 << 6)
+#define  AW8697_DATCTRL_LPF_EN		BIT(5)
+
+#define AW8697_REG_PWMDBG		0x2e
+#define  AW8697_PWMDBG_PWM_MASK		GENMASK(6, 5)
+#define  AW8697_PWMDBG_PWM_24K		(2 << 5)
+
+#define AW8697_REG_BSTDBG1		0x31
+#define AW8697_REG_BSTDBG2		0x32
+#define AW8697_REG_BSTDBG3		0x33
+#define AW8697_REG_BSTCFG		0x34
+#define  AW8697_BSTCFG_PEAKCUR_MASK	GENMASK(2, 0)
+#define  AW8697_BSTCFG_PEAKCUR_3P5A	5
+
+#define AW8697_REG_ANADBG		0x35
+#define  AW8697_ANADBG_IOC_MASK		GENMASK(3, 2)
+#define  AW8697_ANADBG_IOC_4P65A	(3 << 2)
+
+#define AW8697_REG_PRLVL		0x3e
+#define AW8697_REG_PRTIME		0x3f
+
+#define AW8697_REG_GLB_STATE		0x46
+#define AW8697_REG_BST_AUTO		0x47
+#define  AW8697_BST_AUTO_RAM_MASK	BIT(0)
+
+#define AW8697_REG_CONT_CTRL		0x48
+#define  AW8697_CONT_ZC_DETEC_EN	BIT(7)
+#define  AW8697_CONT_WAIT_1PERIOD	0
+#define  AW8697_CONT_BY_GO_SIGNAL	0
+#define  AW8697_CONT_CLOSE_PLAYBACK	BIT(3)
+#define  AW8697_CONT_F0_DETECT_DIS	0
+#define  AW8697_CONT_O2C_DIS		0
+#define  AW8697_CONT_AUTO_BRK_EN	BIT(0)
+
+#define AW8697_REG_F_PRE_H		0x49
+#define AW8697_REG_F_PRE_L		0x4a
+#define AW8697_REG_TD_H			0x4b
+#define AW8697_REG_TD_L			0x4c
+#define AW8697_REG_TSET			0x4d
+#define AW8697_REG_R_SPARE		0x5d
+#define AW8697_REG_ADCTEST		0x66
+#define  AW8697_ADCTEST_VBAT_HW_COMP	BIT(6)
+
+#define AW8697_REG_ZC_THRSH_H		0x72
+#define AW8697_REG_ZC_THRSH_L		0x73
+#define AW8697_REG_BEMF_VTHH_H		0x74
+#define AW8697_REG_BEMF_VTHH_L		0x75
+#define AW8697_REG_BEMF_VTHL_H		0x76
+#define AW8697_REG_BEMF_VTHL_L		0x77
+#define AW8697_REG_BEMF_NUM		0x78
+#define  AW8697_BEMF_NUM_BRK_MASK	GENMASK(3, 0)
+#define AW8697_REG_TIME_NZC		0x7a
+#define AW8697_REG_DRV_LVL		0x7b
+#define AW8697_REG_DRV_LVL_OV		0x7c
+
+/* Default 0815 X-axis LRA parameters (170.0 Hz) */
+#define AW8697_F0_COEFF			260
+#define AW8697_DEFAULT_F0_PRE		1700
+#define AW8697_DEFAULT_CONT_TD		0x009a
+#define AW8697_DEFAULT_ZC_THR		0x0ff1
+#define AW8697_DEFAULT_NUM_BRK		3
+#define AW8697_DEFAULT_DRV_LVL_MAX	105
+#define AW8697_DEFAULT_DRV_LVL_MIN	24
+#define AW8697_DEFAULT_DRV_LVL_OV	125
+
+struct aw8697_data {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *reset_gpio;
+	struct input_dev *input_dev;
+	struct work_struct play_work;
+	struct mutex lock;
+
+	u32 f0_pre;
+	u32 cont_td;
+	u32 cont_zc_thr;
+	u32 cont_num_brk;
+	u32 drv_lvl_max;
+	u32 drv_lvl_ov;
+
+	u16 magnitude;
+	bool running;
+};
+
+static const struct regmap_config aw8697_regmap_cfg = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x7f,
+	.cache_type = REGCACHE_NONE,
+};
+
+static int aw8697_hw_reset(struct aw8697_data *aw)
+{
+	if (!aw->reset_gpio)
+		return 0;
+
+	gpiod_set_value_cansleep(aw->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(aw->reset_gpio, 1);
+	usleep_range(3500, 4500);
+	return 0;
+}
+
+static void aw8697_stop_locked(struct aw8697_data *aw)
+{
+	unsigned int val = 0;
+	int i;
+
+	regmap_update_bits(aw->regmap, AW8697_REG_GO, AW8697_GO_ENABLE, 0);
+	for (i = 0; i < 40; i++) {
+		if (regmap_read(aw->regmap, AW8697_REG_GLB_STATE, &val))
+			break;
+		if ((val & 0x0f) == 0)
+			break;
+		usleep_range(2000, 2500);
+	}
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSINTM,
+			   AW8697_SYSINTM_UVLO_MASK, AW8697_SYSINTM_UVLO_OFF);
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_WORK_MODE_MASK, AW8697_SYSCTRL_STANDBY);
+	aw->running = false;
+}
+
+static int aw8697_init_chip(struct aw8697_data *aw)
+{
+	unsigned int reg = 0;
+	u32 f0_reg;
+
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSINTM,
+			   AW8697_SYSINTM_UVLO_MASK, AW8697_SYSINTM_UVLO_OFF);
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_WORK_MODE_MASK, AW8697_SYSCTRL_STANDBY);
+
+	regmap_update_bits(aw->regmap, AW8697_REG_PWMDBG,
+			   AW8697_PWMDBG_PWM_MASK, AW8697_PWMDBG_PWM_24K);
+
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG1, 0x30);
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG2, 0xeb);
+	regmap_write(aw->regmap, AW8697_REG_BSTDBG3, 0xd4);
+	regmap_write(aw->regmap, AW8697_REG_TSET, 0x12);
+	regmap_write(aw->regmap, AW8697_REG_R_SPARE, 0x68);
+
+	regmap_update_bits(aw->regmap, AW8697_REG_ANADBG,
+			   AW8697_ANADBG_IOC_MASK, AW8697_ANADBG_IOC_4P65A);
+	regmap_update_bits(aw->regmap, AW8697_REG_BSTCFG,
+			   AW8697_BSTCFG_PEAKCUR_MASK, AW8697_BSTCFG_PEAKCUR_3P5A);
+	regmap_write(aw->regmap, AW8697_REG_PRLVL, 0x00);
+	regmap_write(aw->regmap, AW8697_REG_PRTIME, 0x00);
+	regmap_update_bits(aw->regmap, AW8697_REG_BST_AUTO,
+			   AW8697_BST_AUTO_RAM_MASK, 0);
+	regmap_update_bits(aw->regmap, AW8697_REG_ADCTEST,
+			   AW8697_ADCTEST_VBAT_HW_COMP, AW8697_ADCTEST_VBAT_HW_COMP);
+
+	/* Preset LRA resonant frequency (f0_pre in 0.1 Hz units, e.g. 1700 = 170.0 Hz) */
+	f0_reg = 1000000000U / (aw->f0_pre * AW8697_F0_COEFF);
+	regmap_write(aw->regmap, AW8697_REG_F_PRE_H, (f0_reg >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_F_PRE_L, f0_reg & 0xff);
+
+	/* Low-pass filter & continuous closed-loop LRA parameters */
+	regmap_update_bits(aw->regmap, AW8697_REG_DATCTRL,
+			   AW8697_DATCTRL_FC_MASK | AW8697_DATCTRL_LPF_EN,
+			   AW8697_DATCTRL_FC_1000HZ | AW8697_DATCTRL_LPF_EN);
+	regmap_write(aw->regmap, AW8697_REG_CONT_CTRL,
+		     AW8697_CONT_ZC_DETEC_EN | AW8697_CONT_WAIT_1PERIOD |
+		     AW8697_CONT_BY_GO_SIGNAL | AW8697_CONT_CLOSE_PLAYBACK |
+		     AW8697_CONT_F0_DETECT_DIS | AW8697_CONT_O2C_DIS |
+		     AW8697_CONT_AUTO_BRK_EN);
+
+	regmap_write(aw->regmap, AW8697_REG_TD_H, (aw->cont_td >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_TD_L, aw->cont_td & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_ZC_THRSH_H, (aw->cont_zc_thr >> 8) & 0xff);
+	regmap_write(aw->regmap, AW8697_REG_ZC_THRSH_L, aw->cont_zc_thr & 0xff);
+
+	/* Back-EMF auto-braking thresholds */
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHH_H, 0x10);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHH_L, 0x08);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHL_H, 0x03);
+	regmap_write(aw->regmap, AW8697_REG_BEMF_VTHL_L, 0xf8);
+	regmap_update_bits(aw->regmap, AW8697_REG_BEMF_NUM,
+			   AW8697_BEMF_NUM_BRK_MASK, aw->cont_num_brk & 0x0f);
+	regmap_write(aw->regmap, AW8697_REG_TIME_NZC, 0x23);
+
+	/* Clear any pending interrupts */
+	regmap_read(aw->regmap, AW8697_REG_SYSINT, &reg);
+
+	return 0;
+}
+
+static void aw8697_play_work(struct work_struct *work)
+{
+	struct aw8697_data *aw = container_of(work, struct aw8697_data, play_work);
+	unsigned int dummy;
+	u16 mag;
+	u8 drv_lvl;
+
+	mutex_lock(&aw->lock);
+	mag = aw->magnitude;
+
+	if (!mag) {
+		if (aw->running)
+			aw8697_stop_locked(aw);
+		mutex_unlock(&aw->lock);
+		return;
+	}
+
+	drv_lvl = AW8697_DEFAULT_DRV_LVL_MIN +
+		  ((u32)mag * (aw->drv_lvl_max - AW8697_DEFAULT_DRV_LVL_MIN)) / 0xffffU;
+
+	regmap_update_bits(aw->regmap, AW8697_REG_SYSCTRL,
+			   AW8697_SYSCTRL_PLAY_MODE_MASK |
+			   AW8697_SYSCTRL_BST_MODE_MASK |
+			   AW8697_SYSCTRL_WORK_MODE_MASK,
+			   AW8697_SYSCTRL_PLAY_MODE_CONT |
+			   AW8697_SYSCTRL_BST_BYPASS |
+			   AW8697_SYSCTRL_ACTIVE);
+	regmap_read(aw->regmap, AW8697_REG_SYSINT, &dummy);
+
+	regmap_write(aw->regmap, AW8697_REG_DRV_LVL, drv_lvl);
+	regmap_write(aw->regmap, AW8697_REG_DRV_LVL_OV, aw->drv_lvl_ov);
+	regmap_update_bits(aw->regmap, AW8697_REG_GO,
+			   AW8697_GO_ENABLE, AW8697_GO_ENABLE);
+	aw->running = true;
+
+	mutex_unlock(&aw->lock);
+}
+
+static int aw8697_haptics_play(struct input_dev *dev, void *data,
+			       struct ff_effect *effect)
+{
+	struct aw8697_data *aw = input_get_drvdata(dev);
+	u32 level;
+
+	level = effect->u.rumble.strong_magnitude;
+	if (!level)
+		level = effect->u.rumble.weak_magnitude;
+
+	aw->magnitude = level;
+	schedule_work(&aw->play_work);
+	return 0;
+}
+
+static void aw8697_close(struct input_dev *dev)
+{
+	struct aw8697_data *aw = input_get_drvdata(dev);
+
+	cancel_work_sync(&aw->play_work);
+	mutex_lock(&aw->lock);
+	aw->magnitude = 0;
+	aw8697_stop_locked(aw);
+	mutex_unlock(&aw->lock);
+}
+
+static int aw8697_probe(struct i2c_client *i2c)
+{
+	struct aw8697_data *aw;
+	unsigned int chip_id = 0;
+	int ret;
+
+	aw = devm_kzalloc(&i2c->dev, sizeof(*aw), GFP_KERNEL);
+	if (!aw)
+		return -ENOMEM;
+
+	aw->dev = &i2c->dev;
+	mutex_init(&aw->lock);
+	INIT_WORK(&aw->play_work, aw8697_play_work);
+	i2c_set_clientdata(i2c, aw);
+
+	aw->f0_pre = AW8697_DEFAULT_F0_PRE;
+	aw->cont_td = AW8697_DEFAULT_CONT_TD;
+	aw->cont_zc_thr = AW8697_DEFAULT_ZC_THR;
+	aw->cont_num_brk = AW8697_DEFAULT_NUM_BRK;
+	aw->drv_lvl_max = AW8697_DEFAULT_DRV_LVL_MAX;
+	aw->drv_lvl_ov = AW8697_DEFAULT_DRV_LVL_OV;
+
+	of_property_read_u32(i2c->dev.of_node, "awinic,f0-preset", &aw->f0_pre);
+
+	aw->reset_gpio = devm_gpiod_get_optional(&i2c->dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(aw->reset_gpio))
+		return dev_err_probe(&i2c->dev, PTR_ERR(aw->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+	aw->regmap = devm_regmap_init_i2c(i2c, &aw8697_regmap_cfg);
+	if (IS_ERR(aw->regmap))
+		return PTR_ERR(aw->regmap);
+
+	aw8697_hw_reset(aw);
+
+	ret = regmap_read(aw->regmap, AW8697_REG_ID, &chip_id);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "Failed to read chip ID\n");
+
+	if (chip_id != AW8697_CHIP_ID)
+		return dev_err_probe(&i2c->dev, -ENODEV,
+				     "Unexpected chip ID: 0x%02x\n", chip_id);
+
+	ret = aw8697_init_chip(aw);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "Chip init failed\n");
+
+	aw->input_dev = devm_input_allocate_device(&i2c->dev);
+	if (!aw->input_dev)
+		return -ENOMEM;
+
+	aw->input_dev->name = "aw8697-haptics";
+	aw->input_dev->id.bustype = BUS_I2C;
+	aw->input_dev->close = aw8697_close;
+	input_set_drvdata(aw->input_dev, aw);
+	input_set_capability(aw->input_dev, EV_FF, FF_RUMBLE);
+
+	ret = input_ff_create_memless(aw->input_dev, NULL, aw8697_haptics_play);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "Failed to create FF device\n");
+
+	ret = input_register_device(aw->input_dev);
+	if (ret)
+		return dev_err_probe(&i2c->dev, ret, "Failed to register input device\n");
+
+	dev_info(&i2c->dev, "Awinic AW8697 LRA haptics ready (id=0x%02x, f0=%u.%u Hz)\n",
+		 chip_id, aw->f0_pre / 10, aw->f0_pre % 10);
+	return 0;
+}
+
+static void aw8697_remove(struct i2c_client *i2c)
+{
+	struct aw8697_data *aw = i2c_get_clientdata(i2c);
+
+	cancel_work_sync(&aw->play_work);
+	mutex_lock(&aw->lock);
+	aw8697_stop_locked(aw);
+	mutex_unlock(&aw->lock);
+}
+
+static const struct of_device_id aw8697_of_match[] = {
+	{ .compatible = "awinic,aw8697" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw8697_of_match);
+
+static const struct i2c_device_id aw8697_id[] = {
+	{ "aw8697" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw8697_id);
+
+static struct i2c_driver aw8697_driver = {
+	.driver = {
+		.name = "aw8697-haptics",
+		.of_match_table = aw8697_of_match,
+	},
+	.probe = aw8697_probe,
+	.remove = aw8697_remove,
+	.id_table = aw8697_id,
+};
+module_i2c_driver(aw8697_driver);
+
+MODULE_DESCRIPTION("Awinic AW8697 LRA Haptic Driver");
+MODULE_LICENSE("GPL");
