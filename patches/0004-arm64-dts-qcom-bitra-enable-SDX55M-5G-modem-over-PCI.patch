@@ -36,6 +37,8 @@ enum wwan_port_type {
 	WWAN_PORT_ADB,
 	WWAN_PORT_MIPC,
 	WWAN_PORT_NMEA,
+	WWAN_PORT_SAHARA,
+	WWAN_PORT_EFS,
 
 	/* Add new port types above this line */
 
