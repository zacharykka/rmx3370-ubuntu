diff --git a/drivers/power/supply/mp2650_charger.c b/drivers/power/supply/mp2650_charger.c
new file mode 100644
index 000000000..cc7456a77
--- /dev/null
+++ b/drivers/power/supply/mp2650_charger.c
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MPS MP2650 2-cell (2S) buck-boost battery charger driver.
+ *
+ * Supports standard power_supply telemetry (VIN/IIN ADCs, status, fault health,
+ * programmable input current / charge current / float voltage) and standard
+ * charge_behaviour (auto, inhibit-charge bypass, force-discharge HIZ) for 24/7
+ * anti-swelling charge control.
+ */
+
+#include <linux/bits.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/regmap.h>
+
+#define MP2650_REG_IIN_LIM		0x00
+#define MP2650_IIN_LIM_MASK		GENMASK(6, 0)
+#define MP2650_IIN_LIM_STEP_UA		50000
+
+#define MP2650_REG_ICHG			0x02
+#define MP2650_ICHG_STEP_UA		50000
+
+#define MP2650_REG_VFLOAT		0x04
+#define MP2650_VFLOAT_MASK		GENMASK(6, 1)
+#define MP2650_VFLOAT_SHIFT		1
+#define MP2650_VFLOAT_BASE_UV		3712500
+#define MP2650_VFLOAT_STEP_UV		12500
+
+#define MP2650_REG_CTRL0		0x08
+#define MP2650_CTRL0_LEARN_EN		BIT(3) /* HIZ / force-discharge */
+#define MP2650_CTRL0_CHG_EN		BIT(4) /* Charge enable (0 = bypass) */
+#define MP2650_CTRL0_OTG_EN		BIT(5)
+#define MP2650_CTRL0_WTD_RST		BIT(6)
+
+#define MP2650_REG_CTRL1		0x09
+#define MP2650_CTRL1_WTD_MASK		GENMASK(5, 4)
+
+#define MP2650_REG_STATUS		0x13
+#define MP2650_STAT_VIN_PG		BIT(1)
+#define MP2650_STAT_CHG_MASK		GENMASK(3, 2)
+#define MP2650_STAT_CHG_NONE		(0 << 2)
+#define MP2650_STAT_CHG_PRE		(1 << 2)
+#define MP2650_STAT_CHG_FAST		(2 << 2)
+#define MP2650_STAT_CHG_DONE		(3 << 2)
+
+#define MP2650_REG_FAULT		0x14
+#define MP2650_FAULT_NTC_MASK		GENMASK(2, 0)
+#define MP2650_FAULT_BAT_OVP		BIT(3)
+#define MP2650_FAULT_CHG_MASK		GENMASK(5, 4)
+#define MP2650_FAULT_CHG_INPUT		(1 << 4)
+#define MP2650_FAULT_CHG_THERM		(2 << 4)
+#define MP2650_FAULT_CHG_TIMER		(3 << 4)
+
+#define MP2650_REG_REV			0x15
+
+#define MP2650_REG_ADC_VBAT_L		0x16
+#define MP2650_REG_ADC_VSYS_L		0x18
+#define MP2650_REG_ADC_ICHG_L		0x1a
+#define MP2650_REG_ADC_VIN_L		0x1c
+#define MP2650_REG_ADC_IIN_L		0x1e
+
+#define MP2650_MAX_REG			0x29
+
+struct mp2650_charger {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *psy;
+	struct gpio_desc *otg_en_gpio;
+};
+
+static const struct regmap_config mp2650_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = MP2650_MAX_REG,
+};
+
+static int mp2650_read_adc10(struct mp2650_charger *chg, u8 reg_lo, u32 *raw)
+{
+	u8 buf[2];
+	int ret;
+
+	ret = regmap_bulk_read(chg->regmap, reg_lo, buf, 2);
+	if (ret)
+		return ret;
+
+	*raw = (((u32)buf[1] << 8) | buf[0]) >> 6;
+	return 0;
+}
+
+static int mp2650_get_property(struct power_supply *psy,
+			       enum power_supply_property psp,
+			       union power_supply_propval *val)
+{
+	struct mp2650_charger *chg = power_supply_get_drvdata(psy);
+	unsigned int reg;
+	u32 raw;
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = mp2650_read_adc10(chg, MP2650_REG_ADC_VIN_L, &raw);
+		if (ret)
+			return ret;
+		/* VIN ADC step = 25 mV; consider USB online if VIN >= 3.5 V */
+		val->intval = (raw * 25 >= 3500) ? 1 : 0;
+		return 0;
+
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = regmap_read(chg->regmap, MP2650_REG_STATUS, &reg);
+		if (ret)
+			return ret;
+		switch (reg & MP2650_STAT_CHG_MASK) {
+		case MP2650_STAT_CHG_PRE:
+		case MP2650_STAT_CHG_FAST:
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+			break;
+		case MP2650_STAT_CHG_DONE:
+			val->intval = POWER_SUPPLY_STATUS_FULL;
+			break;
+		default:
+			val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			break;
+		}
+		return 0;
+
+	case POWER_SUPPLY_PROP_HEALTH:
+		ret = regmap_read(chg->regmap, MP2650_REG_FAULT, &reg);
+		if (ret)
+			return ret;
+		if (reg & MP2650_FAULT_BAT_OVP)
+			val->intval = POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+		else if ((reg & MP2650_FAULT_CHG_MASK) == MP2650_FAULT_CHG_THERM)
+			val->intval = POWER_SUPPLY_HEALTH_OVERHEAT;
+		else if ((reg & MP2650_FAULT_CHG_MASK) == MP2650_FAULT_CHG_TIMER)
+			val->intval = POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE;
+		else if ((reg & MP2650_FAULT_CHG_MASK) == MP2650_FAULT_CHG_INPUT)
+			val->intval = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+		else
+			val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		ret = mp2650_read_adc10(chg, MP2650_REG_ADC_VIN_L, &raw);
+		if (ret)
+			return ret;
+		val->intval = raw * 25000; /* 25 mV/LSB -> uV */
+		return 0;
+
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		ret = mp2650_read_adc10(chg, MP2650_REG_ADC_IIN_L, &raw);
+		if (ret)
+			return ret;
+		val->intval = raw * 6250; /* 6.25 mA/LSB -> uA */
+		return 0;
+
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = regmap_read(chg->regmap, MP2650_REG_IIN_LIM, &reg);
+		if (ret)
+			return ret;
+		val->intval = (reg & MP2650_IIN_LIM_MASK) * MP2650_IIN_LIM_STEP_UA;
+		return 0;
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = regmap_read(chg->regmap, MP2650_REG_ICHG, &reg);
+		if (ret)
+			return ret;
+		val->intval = reg * MP2650_ICHG_STEP_UA;
+		return 0;
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		ret = regmap_read(chg->regmap, MP2650_REG_VFLOAT, &reg);
+		if (ret)
+			return ret;
+		val->intval = MP2650_VFLOAT_BASE_UV +
+			      ((reg & MP2650_VFLOAT_MASK) >> MP2650_VFLOAT_SHIFT) *
+			      MP2650_VFLOAT_STEP_UV;
+		return 0;
+
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		ret = regmap_read(chg->regmap, MP2650_REG_CTRL0, &reg);
+		if (ret)
+			return ret;
+		if (reg & MP2650_CTRL0_LEARN_EN)
+			val->intval = POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE;
+		else if (!(reg & MP2650_CTRL0_CHG_EN))
+			val->intval = POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+		else
+			val->intval = POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+		return 0;
+
+	case POWER_SUPPLY_PROP_MANUFACTURER:
+		val->strval = "Monolithic Power Systems";
+		return 0;
+
+	case POWER_SUPPLY_PROP_MODEL_NAME:
+		val->strval = "MP2650";
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mp2650_set_property(struct power_supply *psy,
+			       enum power_supply_property psp,
+			       const union power_supply_propval *val)
+{
+	struct mp2650_charger *chg = power_supply_get_drvdata(psy);
+	int clamped, steps;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		clamped = clamp(val->intval, 500000, 3000000);
+		steps = clamped / MP2650_IIN_LIM_STEP_UA;
+		return regmap_update_bits(chg->regmap, MP2650_REG_IIN_LIM,
+					  MP2650_IIN_LIM_MASK, steps);
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		clamped = clamp(val->intval, 100000, 3000000);
+		steps = clamped / MP2650_ICHG_STEP_UA;
+		return regmap_write(chg->regmap, MP2650_REG_ICHG, steps);
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+		/* Per-cell float voltage for 2S pack (clamped to safe 3.80..4.40V) */
+		clamped = clamp(val->intval, 3800000, 4400000);
+		steps = (clamped - MP2650_VFLOAT_BASE_UV) / MP2650_VFLOAT_STEP_UV;
+		return regmap_update_bits(chg->regmap, MP2650_REG_VFLOAT,
+					  MP2650_VFLOAT_MASK,
+					  steps << MP2650_VFLOAT_SHIFT);
+
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		switch (val->intval) {
+		case POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO:
+			return regmap_update_bits(chg->regmap, MP2650_REG_CTRL0,
+						  MP2650_CTRL0_CHG_EN | MP2650_CTRL0_LEARN_EN,
+						  MP2650_CTRL0_CHG_EN);
+		case POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:
+			return regmap_update_bits(chg->regmap, MP2650_REG_CTRL0,
+						  MP2650_CTRL0_CHG_EN | MP2650_CTRL0_LEARN_EN,
+						  0);
+		case POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE:
+			return regmap_update_bits(chg->regmap, MP2650_REG_CTRL0,
+						  MP2650_CTRL0_CHG_EN | MP2650_CTRL0_LEARN_EN,
+						  MP2650_CTRL0_LEARN_EN);
+		default:
+			return -EINVAL;
+		}
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static int mp2650_property_is_writeable(struct power_supply *psy,
+					enum power_supply_property psp)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:
+	case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static enum power_supply_property mp2650_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,
+	POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+	POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR,
+	POWER_SUPPLY_PROP_MANUFACTURER,
+	POWER_SUPPLY_PROP_MODEL_NAME,
+};
+
+static const struct power_supply_desc mp2650_psy_desc = {
+	.name = "mp2650-charger",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = mp2650_props,
+	.num_properties = ARRAY_SIZE(mp2650_props),
+	.get_property = mp2650_get_property,
+	.set_property = mp2650_set_property,
+	.property_is_writeable = mp2650_property_is_writeable,
+	.charge_behaviours = BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO) |
+			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) |
+			     BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_FORCE_DISCHARGE),
+};
+
+static int mp2650_probe(struct i2c_client *client)
+{
+	struct power_supply_config psy_cfg = {};
+	struct mp2650_charger *chg;
+	unsigned int rev;
+	int ret;
+
+	chg = devm_kzalloc(&client->dev, sizeof(*chg), GFP_KERNEL);
+	if (!chg)
+		return -ENOMEM;
+
+	chg->dev = &client->dev;
+	i2c_set_clientdata(client, chg);
+
+	chg->regmap = devm_regmap_init_i2c(client, &mp2650_regmap_config);
+	if (IS_ERR(chg->regmap))
+		return dev_err_probe(chg->dev, PTR_ERR(chg->regmap),
+				     "failed to init regmap\n");
+
+	ret = regmap_read(chg->regmap, MP2650_REG_REV, &rev);
+	if (ret)
+		return dev_err_probe(chg->dev, ret, "failed to read revision\n");
+
+	/* Disable 40s HW watchdog so 24/7 charge-limit settings persist */
+	ret = regmap_update_bits(chg->regmap, MP2650_REG_CTRL1,
+				 MP2650_CTRL1_WTD_MASK, 0);
+	if (ret)
+		dev_warn(chg->dev, "failed to disable watchdog: %d\n", ret);
+
+	chg->otg_en_gpio = devm_gpiod_get_optional(chg->dev, "otg-enable",
+						   GPIOD_OUT_LOW);
+	if (IS_ERR(chg->otg_en_gpio))
+		return dev_err_probe(chg->dev, PTR_ERR(chg->otg_en_gpio),
+				     "failed to get otg-enable gpio\n");
+
+	psy_cfg.drv_data = chg;
+	psy_cfg.fwnode = dev_fwnode(chg->dev);
+	chg->psy = devm_power_supply_register(chg->dev, &mp2650_psy_desc, &psy_cfg);
+	if (IS_ERR(chg->psy))
+		return dev_err_probe(chg->dev, PTR_ERR(chg->psy),
+				     "failed to register power_supply\n");
+
+	dev_info(chg->dev, "MPS MP2650 2S charger probed (rev=0x%02x)\n", rev);
+	return 0;
+}
+
+static const struct of_device_id mp2650_of_match[] = {
+	{ .compatible = "mps,mp2650" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mp2650_of_match);
+
+static const struct i2c_device_id mp2650_id[] = {
+	{ "mp2650" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, mp2650_id);
+
+static struct i2c_driver mp2650_driver = {
+	.driver = {
+		.name = "mp2650-charger",
+		.of_match_table = mp2650_of_match,
+	},
+	.probe = mp2650_probe,
+	.id_table = mp2650_id,
+};
+module_i2c_driver(mp2650_driver);
+
+MODULE_DESCRIPTION("MPS MP2650 2S Battery Charger Driver");
+MODULE_LICENSE("GPL");
