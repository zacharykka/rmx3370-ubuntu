new file mode 100644
index 000000000..5c8914a39
--- /dev/null
+++ b/drivers/input/touchscreen/synaptics_tcm_i2c.c
@@ -0,0 +1,576 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Synaptics TouchComm (TCM) gen-1 I2C touchscreen driver (e.g. S3908)
+ * Clean mainline implementation verified against RMX3370 on-cell S3908 protocol.
+ */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pm.h>
+#include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#define TCM_MARKER			0xa5
+#define TCM_PADDING			0x5a
+#define TCM_HDR_SIZE			4
+#define TCM_MAX_BUF			1024
+#define TCM_MAX_OBJECTS			10
+#define TCM_CMD_TIMEOUT_MS		1000
+
+#define TCM_STATUS_IDLE			0x00
+#define TCM_STATUS_OK			0x01
+#define TCM_STATUS_BUSY			0x02
+#define TCM_STATUS_CONTINUED_READ	0x03
+#define TCM_STATUS_ERROR		0x0f
+
+#define TCM_REPORT_IDENTIFY		0x10
+#define TCM_REPORT_TOUCH		0x11
+
+#define TCM_CMD_IDENTIFY		0x02
+#define TCM_CMD_ENABLE_REPORT		0x05
+#define TCM_CMD_DISABLE_REPORT		0x06
+#define TCM_CMD_RUN_APP_FW		0x14
+#define TCM_CMD_GET_APP_INFO		0x20
+#define TCM_CMD_GET_TOUCH_REPORT_CFG	0x25
+#define TCM_CMD_ENTER_DEEP_SLEEP	0x2c
+#define TCM_CMD_EXIT_DEEP_SLEEP		0x2d
+
+#define TCM_MODE_APPLICATION		0x01
+
+enum tcm_report_code {
+	TOUCH_END = 0,
+	TOUCH_FOREACH_ACTIVE_OBJECT = 1,
+	TOUCH_FOREACH_OBJECT = 2,
+	TOUCH_FOREACH_END = 3,
+	TOUCH_PAD_TO_NEXT_BYTE = 4,
+	TOUCH_TIMESTAMP = 5,
+	TOUCH_OBJECT_N_INDEX = 6,
+	TOUCH_OBJECT_N_CLASSIFICATION = 7,
+	TOUCH_OBJECT_N_X_POSITION = 8,
+	TOUCH_OBJECT_N_Y_POSITION = 9,
+	TOUCH_OBJECT_N_Z = 10,
+	TOUCH_OBJECT_N_X_WIDTH = 11,
+	TOUCH_OBJECT_N_Y_WIDTH = 12,
+	TOUCH_OBJECT_N_TX_POS = 13,
+	TOUCH_OBJECT_N_RX_POS = 14,
+	TOUCH_0D_BUTTONS_STATE = 15,
+	TOUCH_GESTURE_DOUBLE_TAP = 16,
+	TOUCH_FRAME_RATE = 17,
+	TOUCH_POWER_IM = 18,
+	TOUCH_CID_IM = 19,
+	TOUCH_RAIL_IM = 20,
+	TOUCH_CID_VARIANCE_IM = 21,
+	TOUCH_NSM_FREQUENCY = 22,
+	TOUCH_NSM_STATE = 23,
+	TOUCH_NUM_OF_ACTIVE_OBJECTS = 24,
+	TOUCH_NUM_OF_CPU_CYCLES = 25,
+};
+
+struct tcm_obj {
+	u8 status;
+	u16 x;
+	u16 y;
+	u16 z;
+	u16 wx;
+	u16 wy;
+};
+
+struct syna_tcm {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[2];
+
+	struct mutex cmd_lock;
+	struct mutex rw_lock;
+	struct completion cmd_done;
+	u8 cmd_status;
+	u8 resp_buf[TCM_MAX_BUF];
+	u16 resp_len;
+
+	u8 rx_buf[TCM_MAX_BUF];
+	u8 cont_buf[TCM_MAX_BUF];
+	u8 report_cfg[256];
+	u16 report_cfg_len;
+
+	u16 max_x;
+	u16 max_y;
+	u8 max_objects;
+	bool ready;
+};
+
+static int syna_tcm_read_msg(struct syna_tcm *tcm, u8 *code_out, u8 *payload, u16 *len_out)
+{
+	u8 hdr[TCM_HDR_SIZE];
+	u16 payload_len, rem;
+	int ret;
+
+	mutex_lock(&tcm->rw_lock);
+	ret = i2c_master_recv(tcm->client, hdr, sizeof(hdr));
+	if (ret != sizeof(hdr)) {
+		mutex_unlock(&tcm->rw_lock);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	if (hdr[0] != TCM_MARKER) {
+		if (!tcm->ready)
+			dev_dbg(&tcm->client->dev, "tcm bad marker: %4ph\n", hdr);
+		mutex_unlock(&tcm->rw_lock);
+		return -ENXIO;
+	}
+
+	*code_out = hdr[1];
+	payload_len = get_unaligned_le16(&hdr[2]);
+	if (!tcm->ready)
+		dev_dbg(&tcm->client->dev, "tcm rx hdr: code=0x%02x len=%u\n", *code_out, payload_len);
+
+	if (*code_out == TCM_STATUS_IDLE || *code_out == TCM_STATUS_BUSY ||
+	    *code_out == TCM_STATUS_CONTINUED_READ || payload_len == 0) {
+		*len_out = 0;
+		mutex_unlock(&tcm->rw_lock);
+		return 0;
+	}
+
+	if (payload_len > TCM_MAX_BUF - 3) {
+		mutex_unlock(&tcm->rw_lock);
+		return -EMSGSIZE;
+	}
+
+	rem = payload_len + 3;
+	ret = i2c_master_recv(tcm->client, tcm->cont_buf, rem);
+	if (ret != rem) {
+		mutex_unlock(&tcm->rw_lock);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	if (tcm->cont_buf[0] != TCM_MARKER || tcm->cont_buf[1] != TCM_STATUS_CONTINUED_READ) {
+		if (!tcm->ready)
+			dev_info(&tcm->client->dev, "tcm cont bad hdr: %4ph\n", tcm->cont_buf);
+		mutex_unlock(&tcm->rw_lock);
+		return -EIO;
+	}
+
+	memcpy(payload, &tcm->cont_buf[2], payload_len);
+	*len_out = payload_len;
+	mutex_unlock(&tcm->rw_lock);
+	return 0;
+}
+
+static int syna_tcm_send_cmd(struct syna_tcm *tcm, u8 cmd, const u8 *data, u16 data_len,
+			     u8 *resp, u16 *resp_len)
+{
+	u8 tx[64];
+	int ret;
+
+	if (data_len + 3 > sizeof(tx))
+		return -EINVAL;
+
+	mutex_lock(&tcm->cmd_lock);
+	reinit_completion(&tcm->cmd_done);
+	tcm->cmd_status = 0xff;
+	tcm->resp_len = 0;
+
+	tx[0] = cmd;
+	put_unaligned_le16(data_len, &tx[1]);
+	if (data_len && data)
+		memcpy(&tx[3], data, data_len);
+
+	mutex_lock(&tcm->rw_lock);
+	ret = i2c_master_send(tcm->client, tx, data_len + 3);
+	mutex_unlock(&tcm->rw_lock);
+	if (ret != data_len + 3) {
+		mutex_unlock(&tcm->cmd_lock);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	if (!wait_for_completion_timeout(&tcm->cmd_done, msecs_to_jiffies(TCM_CMD_TIMEOUT_MS))) {
+		mutex_unlock(&tcm->cmd_lock);
+		return -ETIMEDOUT;
+	}
+
+	if (tcm->cmd_status != TCM_STATUS_OK) {
+		ret = -EIO;
+	} else {
+		if (resp && resp_len) {
+			u16 n = min_t(u16, tcm->resp_len, *resp_len);
+			memcpy(resp, tcm->resp_buf, n);
+			*resp_len = n;
+		}
+		ret = 0;
+	}
+
+	mutex_unlock(&tcm->cmd_lock);
+	return ret;
+}
+
+static u32 tcm_get_bits(const u8 *buf, u16 buf_len, u32 bit_off, u8 bits)
+{
+	u32 val = 0;
+	u8 i;
+
+	for (i = 0; i < bits && i < 32; i++) {
+		u32 byte_idx = (bit_off + i) / 8;
+		u8 bit_idx = (bit_off + i) % 8;
+		if (byte_idx < buf_len && (buf[byte_idx] & BIT(bit_idx)))
+			val |= BIT(i);
+	}
+	return val;
+}
+
+static void syna_tcm_parse_touch(struct syna_tcm *tcm, const u8 *buf, u16 len)
+{
+	struct tcm_obj objs[TCM_MAX_OBJECTS];
+	bool active_only = false, has_active_cnt = false;
+	u32 active_cnt = 0, seen_objs = 0, obj = 0;
+	u32 off = 0, next_idx = 0, idx = 0;
+	u8 code, bits;
+	int i;
+
+	if (!tcm->ready || !tcm->report_cfg_len)
+		return;
+
+	memset(objs, 0, sizeof(objs));
+
+	while (idx < tcm->report_cfg_len) {
+		code = tcm->report_cfg[idx++];
+		switch (code) {
+		case TOUCH_END:
+			goto report_input;
+		case TOUCH_FOREACH_ACTIVE_OBJECT:
+			obj = 0;
+			seen_objs = 0;
+			next_idx = idx;
+			active_only = true;
+			break;
+		case TOUCH_FOREACH_OBJECT:
+			obj = 0;
+			next_idx = idx;
+			active_only = false;
+			break;
+		case TOUCH_FOREACH_END:
+			if (active_only) {
+				if (has_active_cnt) {
+					seen_objs++;
+					if (seen_objs < active_cnt)
+						idx = next_idx;
+				} else if (off + 8 <= (u32)len * 8) {
+					idx = next_idx;
+				}
+			} else {
+				obj++;
+				if (obj < tcm->max_objects)
+					idx = next_idx;
+			}
+			break;
+		case TOUCH_PAD_TO_NEXT_BYTE:
+			off = round_up(off, 8);
+			break;
+		case TOUCH_NUM_OF_ACTIVE_OBJECTS:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			active_cnt = tcm_get_bits(buf, len, off, bits);
+			has_active_cnt = true;
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_INDEX:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			obj = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_CLASSIFICATION:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].status = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_X_POSITION:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].x = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_Y_POSITION:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].y = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_Z:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].z = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_X_WIDTH:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].wx = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		case TOUCH_OBJECT_N_Y_WIDTH:
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			if (obj < TCM_MAX_OBJECTS)
+				objs[obj].wy = tcm_get_bits(buf, len, off, bits);
+			off += bits;
+			break;
+		default:
+			/* Any other field carries a 1-byte bit-width specifier */
+			if (idx >= tcm->report_cfg_len)
+				goto report_input;
+			bits = tcm->report_cfg[idx++];
+			off += bits;
+			break;
+		}
+	}
+
+report_input:
+	for (i = 0; i < tcm->max_objects; i++) {
+		bool down = (objs[i].status == 1 || objs[i].status == 2);
+
+		input_mt_slot(tcm->input, i);
+		input_mt_report_slot_state(tcm->input, MT_TOOL_FINGER, down);
+		if (down) {
+			touchscreen_report_pos(tcm->input, &tcm->prop, objs[i].x, objs[i].y, true);
+			input_report_abs(tcm->input, ABS_MT_TOUCH_MAJOR, max(objs[i].wx, objs[i].wy));
+			input_report_abs(tcm->input, ABS_MT_TOUCH_MINOR, min(objs[i].wx, objs[i].wy));
+			input_report_abs(tcm->input, ABS_MT_PRESSURE, objs[i].z ? objs[i].z : 50);
+		}
+	}
+	input_mt_sync_frame(tcm->input);
+	input_sync(tcm->input);
+}
+
+static irqreturn_t syna_tcm_irq(int irq, void *data)
+{
+	struct syna_tcm *tcm = data;
+	u8 code = 0;
+	u16 len = 0;
+	int ret;
+
+	ret = syna_tcm_read_msg(tcm, &code, tcm->rx_buf, &len);
+	if (ret < 0)
+		return IRQ_HANDLED;
+
+	if (code == TCM_REPORT_TOUCH) {
+		syna_tcm_parse_touch(tcm, tcm->rx_buf, len);
+	} else if (code == TCM_REPORT_IDENTIFY) {
+		/* Ignore spontaneous identify report during boot */
+	} else if (code == TCM_STATUS_OK || (code >= 0x0c && code <= TCM_STATUS_ERROR)) {
+		tcm->cmd_status = code;
+		tcm->resp_len = len;
+		if (len)
+			memcpy(tcm->resp_buf, tcm->rx_buf, len);
+		complete(&tcm->cmd_done);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int syna_tcm_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct syna_tcm *tcm;
+	u8 id_buf[32], app_buf[64];
+	u16 len;
+	u8 report_id = TCM_REPORT_TOUCH;
+	int ret;
+
+	tcm = devm_kzalloc(dev, sizeof(*tcm), GFP_KERNEL);
+	if (!tcm)
+		return -ENOMEM;
+
+	tcm->client = client;
+	i2c_set_clientdata(client, tcm);
+	mutex_init(&tcm->cmd_lock);
+	mutex_init(&tcm->rw_lock);
+	init_completion(&tcm->cmd_done);
+
+	tcm->supplies[0].supply = "vdd";
+	tcm->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(tcm->supplies), tcm->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	tcm->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(tcm->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(tcm->reset_gpio), "Failed to get reset GPIO\n");
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(tcm->supplies), tcm->supplies);
+	if (ret)
+		return ret;
+
+	if (tcm->reset_gpio) {
+		usleep_range(10000, 11000);
+		gpiod_set_value_cansleep(tcm->reset_gpio, 0); /* deassert ACTIVE_LOW reset */
+		msleep(90);
+	}
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, syna_tcm_irq,
+					IRQF_ONESHOT, dev_name(dev), tcm);
+	if (ret) {
+		dev_err(dev, "Failed to request IRQ %d: %d\n", client->irq, ret);
+		goto err_reg;
+	}
+
+	msleep(50);
+
+	/* 1. Identify device & ensure Application firmware mode */
+	len = sizeof(id_buf);
+	memset(id_buf, 0, sizeof(id_buf));
+	ret = syna_tcm_send_cmd(tcm, TCM_CMD_IDENTIFY, NULL, 0, id_buf, &len);
+	if (ret) {
+		dev_err(dev, "CMD_IDENTIFY failed: %d\n", ret);
+		goto err_reg;
+	}
+
+	if (id_buf[1] != TCM_MODE_APPLICATION) {
+		dev_info(dev, "Touch in mode 0x%02x, switching to application firmware...\n", id_buf[1]);
+		syna_tcm_send_cmd(tcm, TCM_CMD_RUN_APP_FW, NULL, 0, NULL, NULL);
+		msleep(90);
+		len = sizeof(id_buf);
+		ret = syna_tcm_send_cmd(tcm, TCM_CMD_IDENTIFY, NULL, 0, id_buf, &len);
+		if (ret || id_buf[1] != TCM_MODE_APPLICATION) {
+			dev_err(dev, "Failed to enter app mode (ret=%d mode=0x%02x)\n", ret, id_buf[1]);
+			ret = ret ? ret : -EIO;
+			goto err_reg;
+		}
+	}
+
+	/* 2. Query application info (max_x, max_y, max_objects) */
+	len = sizeof(app_buf);
+	memset(app_buf, 0, sizeof(app_buf));
+	ret = syna_tcm_send_cmd(tcm, TCM_CMD_GET_APP_INFO, NULL, 0, app_buf, &len);
+	if (ret || len < 38) {
+		dev_err(dev, "CMD_GET_APP_INFO failed: ret=%d len=%u\n", ret, len);
+		ret = ret ? ret : -EIO;
+		goto err_reg;
+	}
+
+	tcm->max_x = get_unaligned_le16(&app_buf[32]);
+	tcm->max_y = get_unaligned_le16(&app_buf[34]);
+	tcm->max_objects = clamp_t(u16, get_unaligned_le16(&app_buf[36]), 1, TCM_MAX_OBJECTS);
+
+	/* 3. Query dynamic touch report configuration */
+	len = sizeof(tcm->report_cfg);
+	ret = syna_tcm_send_cmd(tcm, TCM_CMD_GET_TOUCH_REPORT_CFG, NULL, 0, tcm->report_cfg, &len);
+	if (ret || !len) {
+		dev_err(dev, "CMD_GET_TOUCH_REPORT_CFG failed: ret=%d len=%u\n", ret, len);
+		ret = ret ? ret : -EIO;
+		goto err_reg;
+	}
+	tcm->report_cfg_len = len;
+
+	/* 4. Register Linux input_mt device */
+	tcm->input = devm_input_allocate_device(dev);
+	if (!tcm->input) {
+		ret = -ENOMEM;
+		goto err_reg;
+	}
+
+	tcm->input->name = "Synaptics S3908 Touchscreen";
+	tcm->input->id.bustype = BUS_I2C;
+	tcm->input->dev.parent = dev;
+
+	input_set_abs_params(tcm->input, ABS_MT_POSITION_X, 0, tcm->max_x ? tcm->max_x : 1079, 0, 0);
+	input_set_abs_params(tcm->input, ABS_MT_POSITION_Y, 0, tcm->max_y ? tcm->max_y : 2399, 0, 0);
+	input_set_abs_params(tcm->input, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	input_set_abs_params(tcm->input, ABS_MT_TOUCH_MINOR, 0, 255, 0, 0);
+	input_set_abs_params(tcm->input, ABS_MT_PRESSURE, 0, 255, 0, 0);
+	touchscreen_parse_properties(tcm->input, true, &tcm->prop);
+
+	ret = input_mt_init_slots(tcm->input, tcm->max_objects, INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		goto err_reg;
+
+	ret = input_register_device(tcm->input);
+	if (ret)
+		goto err_reg;
+
+	tcm->ready = true;
+	syna_tcm_send_cmd(tcm, TCM_CMD_ENABLE_REPORT, &report_id, 1, NULL, NULL);
+
+	dev_info(dev, "Synaptics TCM %.16s ready (build=%u, %ux%u, max_fingers=%u, cfg=%uB)\n",
+		 &id_buf[2], get_unaligned_le32(&id_buf[18]),
+		 tcm->max_x, tcm->max_y, tcm->max_objects, tcm->report_cfg_len);
+	return 0;
+
+err_reg:
+	regulator_bulk_disable(ARRAY_SIZE(tcm->supplies), tcm->supplies);
+	return ret;
+}
+
+static void syna_tcm_remove(struct i2c_client *client)
+{
+	struct syna_tcm *tcm = i2c_get_clientdata(client);
+	u8 report_id = TCM_REPORT_TOUCH;
+
+	tcm->ready = false;
+	syna_tcm_send_cmd(tcm, TCM_CMD_DISABLE_REPORT, &report_id, 1, NULL, NULL);
+	regulator_bulk_disable(ARRAY_SIZE(tcm->supplies), tcm->supplies);
+}
+
+static int syna_tcm_suspend(struct device *dev)
+{
+	struct syna_tcm *tcm = dev_get_drvdata(dev);
+
+	syna_tcm_send_cmd(tcm, TCM_CMD_ENTER_DEEP_SLEEP, NULL, 0, NULL, NULL);
+	disable_irq(tcm->client->irq);
+	return 0;
+}
+
+static int syna_tcm_resume(struct device *dev)
+{
+	struct syna_tcm *tcm = dev_get_drvdata(dev);
+
+	enable_irq(tcm->client->irq);
+	syna_tcm_send_cmd(tcm, TCM_CMD_EXIT_DEEP_SLEEP, NULL, 0, NULL, NULL);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(syna_tcm_pm_ops, syna_tcm_suspend, syna_tcm_resume);
+
+static const struct of_device_id syna_tcm_of_match[] = {
+	{ .compatible = "syna,s3908" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, syna_tcm_of_match);
+
+static struct i2c_driver syna_tcm_driver = {
+	.probe = syna_tcm_probe,
+	.remove = syna_tcm_remove,
+	.driver = {
+		.name = "synaptics-tcm-i2c",
+		.of_match_table = syna_tcm_of_match,
+		.pm = pm_sleep_ptr(&syna_tcm_pm_ops),
+	},
+};
+module_i2c_driver(syna_tcm_driver);
+
+MODULE_DESCRIPTION("Synaptics TouchComm (TCM) gen-1 I2C touchscreen driver");
+MODULE_LICENSE("GPL");
