From 85282f26fe8eff012a1464101c902e8fe333ac1e Mon Sep 17 00:00:00 2001
From: ut-bitra <ut-bitra@localhost>
Date: Sun, 22 Nov 2026 12:26:59 +0800
Subject: [PATCH] arm64: dts: qcom: bitra: enable AMS662ZS01 OLED, Adreno 650
 GPU, S3908 touch & volume keys

- Add Samsung AMS662ZS01 1080x2400 command-mode DSC 1.1 AMOLED panel driver with native 12-bit DCS backlight and true DPMS off/on.

- Add Synaptics TouchComm gen-1 I2C touchscreen driver (syna,s3908 on I2C13 0x4b, native 8639x19199 10-finger MT Protocol B).

- Add qcom,kona UBWC config alias in ubwc_config.c so stock ABL dtbo root compatible overwrite still resolves SM8250 UBWC 4.0 HBB16.

- Enable &gmu, &gpu, &gpu_zap_shader (a650_zap.mbn), &mdss, &mdss_dsi0, &mdss_dsi0_phy, &qupv3_id_1, &i2c13, vreg_l1c_1p8, vreg_l11c_3p0, and pm8150 gpio6/gpio7 Volume Up/Down keys.
---
 .../boot/dts/qcom/sm8250-realme-bitra.dts     | 165 +++++
 drivers/gpu/drm/panel/Kconfig                 |   9 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 .../gpu/drm/panel/panel-samsung-ams662zs01.c  | 301 +++++++++
 drivers/input/touchscreen/Kconfig             |   7 +
 drivers/input/touchscreen/Makefile            |   1 +
 drivers/input/touchscreen/synaptics_tcm_i2c.c | 576 ++++++++++++++++++
 drivers/soc/qcom/ubwc_config.c                |   1 +
 8 files changed, 1061 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-ams662zs01.c
 create mode 100644 drivers/input/touchscreen/synaptics_tcm_i2c.c

diff --git a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
index 7ef2bef92..6a60c4690 100644
--- a/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-realme-bitra.dts
@@ -89,6 +89,28 @@ psci {
 		power-domain-cpu-cluster0 { /delete-property/ domain-idle-states; };
 	};
 
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-0 = <&vol_up_n &vol_down_n>;
+		pinctrl-names = "default";
+
+		key-vol-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8150_gpios 6 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+
+		key-vol-down {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&pm8150_gpios 7 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
 	vph_pwr: vph-pwr-regulator {
 		compatible = "regulator-fixed";
 		regulator-name = "vph_pwr";
@@ -453,6 +475,13 @@ vreg_s8c_1p3: smps8 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		vreg_l1c_1p8: ldo1 {
+			regulator-name = "vreg_l1c_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_l2c_1p15: ldo2 {
 			regulator-name = "vreg_l2c_1p15";
 			regulator-boot-on;
@@ -461,6 +490,13 @@ vreg_l2c_1p15: ldo2 {
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
+		vreg_l11c_3p0: ldo11 {
+			regulator-name = "vreg_l11c_3p0";
+			regulator-min-microvolt = <2832000>;
+			regulator-max-microvolt = <3304000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
 		vreg_bob: bob {
 			regulator-name = "vreg_bob";
 			regulator-min-microvolt = <3008000>;
@@ -704,3 +740,132 @@ &pcie2_phy {
 	vdda-pll-supply = <&vreg_l9a_1p2>;
 	status = "okay";
 };
+
+/* Adreno 650 GPU + ZAP shader (a650_zap.mbn from stock vendor firmware) */
+&gmu {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	memory-region = <&gpu_mem>;
+	firmware-name = "qcom/sm8250/realme/bitra/a650_zap.mbn";
+};
+
+/* Display subsystem + Samsung AMS662ZS01 1080x2400 AMOLED DSC panel on DSI0 */
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+
+	display_panel: panel@0 {
+		compatible = "samsung,ams662zs01";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p8>;
+		vci-supply = <&vreg_l13a_3p0>;
+		vddr-supply = <&vreg_l2c_1p15>;
+
+		reset-gpios = <&tlmm 75 GPIO_ACTIVE_LOW>;
+		vout-gpios = <&tlmm 125 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-0 = <&sde_dsi_active &sde_te_active>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	status = "okay";
+};
+
+/* QUPv3 wrap 1 -> I2C13 (0xa94000): Synaptics S3908 TouchComm touchscreen @ 0x4b */
+&qupv3_id_1 {
+	status = "okay";
+};
+
+&i2c13 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@4b {
+		compatible = "syna,s3908";
+		reg = <0x4b>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <39 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&vreg_l11c_3p0>;
+		vddio-supply = <&vreg_l1c_1p8>;
+
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+		pinctrl-names = "default";
+
+	};
+};
+
+&pm8150_gpios {
+	vol_up_n: vol-up-n-state {
+		pins = "gpio6";
+		function = "normal";
+		power-source = <1>;
+		input-enable;
+		bias-pull-up;
+	};
+
+	vol_down_n: vol-down-n-state {
+		pins = "gpio7";
+		function = "normal";
+		power-source = <1>;
+		input-enable;
+		bias-pull-up;
+	};
+};
+
+&tlmm {
+	sde_dsi_active: sde-dsi-active-state {
+		pins = "gpio75";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	sde_te_active: sde-te-active-state {
+		pins = "gpio66";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	ts_int_active: ts-int-active-state {
+		pins = "gpio39";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio38";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+};
