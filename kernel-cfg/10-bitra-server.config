# Production Ubuntu 24.04 LTS Server (ARM64) kernel config fragment for RMX3370 (bitra)
CONFIG_LOCALVERSION="-bitra12"
# CONFIG_LOCALVERSION_AUTO is not set

# Containers / Docker / Podman / cgroup v2 / namespaces
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_BPF=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_OVERLAY_FS=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VXLAN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m

# Firewall / nftables / iptables / WireGuard
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_CONNTRACK=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_WIREGUARD=m

# Ubuntu security & filesystems
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"
CONFIG_PSI=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_CRYPTO_LZ4=y
CONFIG_ZSWAP=y
CONFIG_FUSE_FS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DM_CRYPT=m
CONFIG_UHID=m
CONFIG_CIFS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m

# Server peripherals (Step 6 & P1.5 ready)
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDC_ETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_TYPEC=m
CONFIG_TYPEC_QCOM_PMIC=m
CONFIG_TYPEC_MUX_FSA4480=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_MHI_BUS=m
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_MHI_NET=m
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m
CONFIG_WWAN=m

CONFIG_CHARGER_MP2650=m

# Docker iptables-nft (nf_tables compat) & iptables-legacy full support
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_IPV4=m
CONFIG_NFT_REJECT_IPV6=m
CONFIG_NFT_REJECT_INET=m
CONFIG_BRIDGE_NETFILTER=m

# MHI debugfs telemetry for SDX55M modem bring-up
CONFIG_MHI_BUS_DEBUG=y

# Optional Display (AMS662ZS01 OLED + DSC), Adreno 650 GPU, S3908 Touch & Buttons
CONFIG_DRM=m
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_DRM_PANEL_SAMSUNG_AMS662ZS01=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_I2C=m
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
# Built-in GPU/Display clock controllers so built-in arm-smmu (3da0000.iommu) never races 10s deferred_probe_timeout
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_DISPCC_8250=y

# QCA6390 Bluetooth (Classic A2DP/HFP + BLE + HID/UHID) & SM8250 Audio (ADSP + Dual TFA9874 + WCD9380)
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_UHID=y
CONFIG_SND_SEQUENCER=m
CONFIG_SND_SOC_TFA9874=m
